extends RefCounted
const Flow = preload("res://world/run_flow.gd")
const Room = preload("res://world/room_template.gd")
const RunState = preload("res://world/run_state.gd")
const Reward = preload("res://world/reward_generator.gd")
const Merchant = preload("res://world/merchant.gd")
const Session = preload("res://combat/combat_session.gd")
const Editor = preload("res://magic/editor/spell_editor.gd")
func run(t) -> void:
	var f = Flow.new(20261022)
	t.check(f.initialized,"TASK-036 M3 configuration initializes")
	t.equal(f.state,"fighting","TASK-036 entrance starts locked combat room")
	t.equal(f.room.values["id"],"s1_r1","TASK-038 seeded new run starts first room")
	t.equal(f.run.sequence_index,0,"TASK-039 new run starts index 0")
	t.check(f.session.world.valid_position(f.session.sim.actor.position,f.session.sim.actor.radius),
		"TASK-036 player entrance free of walls")
	t.equal(f.try_exit(f.room.marker("exit"))["reason"],"DOOR_LOCKED","TASK-036 combat door locked")
	t.equal(f.open_editor(0)["reason"],"COMBAT_LOCKED","TASK-047 editor blocked midcombat")
	t.check(f.change_edit_policy("cleared_room"),"TASK-047 switch to cleared-room policy")
	t.equal(f.open_editor(0)["reason"],"COMBAT_LOCKED","TASK-047 policy cannot bypass combat lock")
	var room = Room.new()
	var sample: Dictionary = f.config["rooms"][0].duplicate(true)
	sample.erase("entrance")
	var invalid: Dictionary = room.initialize(sample,f.session.data["arena"],f.session.data["enemies"].keys())
	t.check(not invalid["ok"],"TASK-036 missing marker is invalid")
	t.equal(invalid["issues"][0]["code"],"ROOM_MISSING_FIELD","TASK-036 precise missing marker diagnostic")
	var overlapped: Dictionary = f.config["rooms"][0].duplicate(true)
	overlapped["waves"][0]["enemies"][0] = ["pursuer",185,450]
	var issue: Dictionary = room.initialize(overlapped,f.session.data["arena"],f.session.data["enemies"].keys())
	t.check(not issue["ok"],"TASK-036 enemy spawn overlapping entrance rejected")
	t.check(issue["issues"].any(func(x):return x["code"]=="ROOM_SPAWN_AT_ENTRANCE"),"TASK-036 blocked entrance diagnostic")
	var expected: Dictionary = f.run.snapshot()
	var partial: Dictionary = expected.duplicate(true)
	partial["schema_version"] = 97
	var pristine: Dictionary = f.run.snapshot()
	t.equal(f.run.restore(partial,f.session.sim.registry,6)["reason"],"RUN_VERSION_OR_INDEX_INVALID","TASK-039 unknown save version rejected")
	t.equal(f.run.snapshot(),pristine,"TASK-039 invalid saved state cannot partially mutate run")
	partial = expected.duplicate(true)
	partial["currency"] = -15
	t.equal(f.run.restore(partial,f.session.sim.registry,6)["reason"],"RUN_VALUE_INVALID_currency","TASK-039 negative currency save rejected")
	partial = expected.duplicate(true)
	partial["unlocked"] = ["essence.fire"]
	t.equal(f.run.restore(partial,f.session.sim.registry,6)["reason"],"RUN_FORMULA_INVALID","TASK-040 saved illegal locked spell rejected")
	t.equal(f.run.snapshot(),pristine,"TASK-040 invalid save cannot change loadout")
	var success = f.run.restore(pristine,f.session.sim.registry,6)
	t.check(success["ok"],"TASK-039 valid save can be restored")
	var stable = Reward.new(f.config)
	var reward_a: Array = stable.choices(f.run,"s1_r1")
	t.equal(reward_a,stable.choices(f.run,"s1_r1"),"TASK-041 identical seed and room choose same rewards")
	t.check(reward_a.size() >= 2,"TASK-041 first room offers a rune and currency")
	var different := false
	for seed in range(1,40):
		var copy = RunState.new()
		copy.initialize(seed,f.config,f.formulas)
		if stable.choices(copy,"s1_r1") != reward_a:
			different = true
			break
	t.check(different,"TASK-041 different seeds can produce different rune choices")
	f.session.enemies[0].target.receive_damage(1000.0,"fire",f.session.sim.actor.team,100.0)
	f.step()
	t.equal(f.state,"cleared","TASK-036 only after last required kill does door open")
	t.equal(f.snapshot()["door_open"],true,"TASK-036 cleared room exit unlocked")
	var before_coins: int = f.run.currency
	var option: Dictionary = f.choose_reward(0)
	t.check(option["ok"],"TASK-041 a rune reward may be granted")
	t.check(f.reward_options[0]["id"] in f.run.unlocked,"TASK-040 selected rune becomes known immediately")
	t.equal(f.choose_reward(0)["reason"],"REWARD_NOT_AVAILABLE","TASK-041 reward cannot be granted twice")
	t.equal(f.run.currency,before_coins,"TASK-041 first unique rune reward does not also grant currency")
	t.equal(f.try_exit(f.room.marker("entrance"))["reason"],"EXIT_TOO_FAR","TASK-036 doorway proximity enforced")
	t.check(f.try_exit(f.room.marker("exit"))["ok"],"TASK-038 advances to second room")
	t.equal(f.room.values["id"],"s1_r2","TASK-038 second room selected")
	t.check(f.run.unlocked.size()>5 and f.session.sim.loadout.unlocked.size()==f.run.unlocked.size(),
		"TASK-040 new runes preserved across transition")
	t.equal(f.session.sim.actor.position,f.room.marker("entrance"),"TASK-036 no spawn overlap on room entry")
	t.equal(f.session.sim.queue.active_effect_count(),0,"TASK-038 old magic entities removed across rooms")
	t.equal(f.session.enemy_shots.size(),0,"TASK-038 hostile shots removed across rooms")
	t.equal(f.encounter.schedule.size(),2,"TASK-037 two-wave room configured")
	var director = f.encounter
	t.equal(f.session.alive_enemies(),2,"TASK-037 only first wave initially spawns")
	for enemy in f.session.enemies:
		enemy.target.receive_damage(1000,"fire",1,100.0)
	f.step()
	t.equal(f.state,"fighting","TASK-037 first wave dying does not clear room with pending wave")
	t.equal(director.clear_emissions,0,"TASK-037 no premature room clear")
	for i in 32:
		f.step()
	t.equal(f.session.alive_enemies(),1,"TASK-037 second wave spawns after delay")
	t.equal(director.log.filter(func(x):return x["event"]=="wave_spawn").size(),2,
		"TASK-037 spawn schedule emits twice")
	f.session.enemies[-1].target.receive_damage(1000,"fire",1,100.0)
	f.step()
	t.equal(f.state,"cleared","TASK-037 completed second wave unlocks room")
	t.equal(director.clear_emissions,1,"TASK-037 completion emitted once")
	f.step()
	t.equal(director.clear_emissions,1,"TASK-037 completion not duplicated")
	var rune_id: String = str(f.run.unlocked[-1])
	var duplicate_cash: int = f.run.currency
	f.run.unlock(rune_id,int(f.config["duplicate_reward_currency"]))
	t.equal(f.run.currency,duplicate_cash+int(f.config["duplicate_reward_currency"]),"TASK-040 duplicate reward pays deterministic currency")
	var initial_formula: Dictionary = f.run.formulas[0].duplicate(true)
	t.check(f.open_editor(0)["ok"],"TASK-047 cleared room quick editor opens when policy enabled")
	t.equal(f.open_editor(1)["reason"],"EDITOR_ALREADY_OPEN","TASK-044 concurrent editor open cannot overwrite draft")
	t.equal(f.try_exit(f.room.marker("exit"))["reason"],"EDITOR_OPEN","TASK-047 cannot transition with an active editor draft")
	t.equal(f.mode,"combat","TASK-047 quick edit has no workshop/shop/test access")
	t.check(not f.enter_test_range()["ok"],"TASK-047 test range blocked outside workshop")
	t.check(not f.buy(0)["ok"],"TASK-047 merchant blocked outside workshop")
	var editor = f.editor
	t.check(editor.set_root("essence.water","form.projectile")["ok"],"TASK-044 novice builds Water Projectile")
	editor.toggle_modifier("mod.split")
	t.equal(editor.validate()["ok"],"mod.split" in f.run.unlocked,"TASK-044 modifier legality uses unlocked inventory")
	t.check(f.close_editor(false,2.0)["ok"],"TASK-044 cancel closes without applying")
	t.equal(f.run.formulas[0],initial_formula,"TASK-044 cancelling restores equipped formula exactly")
	t.equal(f.run.quick_edit_count,1,"TASK-047 quick edit instrumentation")
	t.equal(f.run.edit_seconds,2.0,"TASK-047 edit duration captured")
	t.check(f.open_editor(0)["ok"],"TASK-044 editor reopens transaction")
	editor = f.editor
	editor.set_root("essence.water","form.projectile")
	if "mod.split" in f.run.unlocked:
		editor.toggle_modifier("mod.split")
	var applied: Dictionary = f.close_editor(true,1.0)
	t.check(applied["ok"],"TASK-044 apply compiled valid draft")
	t.equal(f.run.formulas[0]["root"]["essence_id"],"essence.water","TASK-044 edited spell persists in run")
	t.equal(f.run.formulas[0]["display_name"],"Custom Spell 1","TASK-044 edited spell gets truthful display name")
	t.equal(f.session.sim.loadout.preview(0)["formula_id"],"custom.slot_1","TASK-044 live loadout recompiles")
	var previous: Dictionary = f.run.formulas[0].duplicate(true)
	t.check(f.open_editor(0)["ok"],"TASK-044 another edit opens")
	f.editor.set_root("essence.fire","form.orb")
	t.check(not f.editor.validate()["ok"],"TASK-044 locked Orb draft rejected")
	t.equal(f.close_editor(true)["reason"],"FORMULA_INVALID","TASK-044 invalid edit cannot commit")
	t.equal(f.run.formulas[0],previous,"TASK-044 failed transaction does not touch equipped")
	t.check(f.close_editor(false)["ok"],"TASK-044 can cancel failed draft")
	t.check(f.change_edit_policy("workshop_only"),"TASK-047 policy can switch back")
	t.equal(f.open_editor(0)["reason"],"POLICY_WORKSHOP_ONLY","TASK-047 cleared quick edit disabled by policy")
	t.equal(f.run.formulas[0]["schema_version"],1,"TASK-047 policy switching never changes formula schema")
	var restore_new = Flow.new(20261022)
	var loaded: Dictionary = restore_new.recover(f.run.snapshot())
	t.check(loaded["ok"],"TASK-039 serialized state can reenter a room")
	t.equal(restore_new.run.currency,f.run.currency,"TASK-039 currency survives save")
	t.equal(restore_new.run.formulas,f.run.formulas,"TASK-039 formula survives save")
	t.equal(restore_new.session.sim.queue.active_effect_count(),0,"TASK-039 runtime entities excluded from persisted save")
