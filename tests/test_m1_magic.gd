extends RefCounted
const Runner = preload("res://magic/runtime/spell_runner.gd")
const Target = preload("res://combat/magic_target.gd")
const Store = preload("res://combat/target_store.gd")
const Status = preload("res://combat/status_component.gd")
const Resolver = preload("res://combat/interaction_resolver.gd")
const Projectile = preload("res://magic/runtime/projectile_effect.gd")
const Registry = preload("res://magic/data/rune_registry.gd")

var samples: Dictionary = {}

func _samples(t) -> void:
	var fixture = t.fixture("m1_samples.json")
	for value in fixture["formulas"]:
		samples[str(value["formula_id"])] = value

func _init_runner() -> Variant:
	return Runner.new(4042)

func _run_ticks(runner, count: int) -> void:
	for i in count:
		runner.step()

func run(t) -> void:
	_samples(t)
	var r = _init_runner()
	t.check(r.initialized,"TASK-011 M1 runtime initializes")
	t.equal(r.registry.get_ids().size(),10,"TASK-012 same registry for all essence payloads")
	var ally = Target.new(991,1,Vector2(330,340))
	t.check(r.targets.add(ally),"TASK-011 new same-team target supported")
	var enemy = r.add_target(Vector2(350,340))
	var tied = r.add_target(Vector2(350,360))
	var query: Array = r.targets.query(Vector2(350,350),200,1)
	t.equal([query[0].id,query[1].id],[enemy.id,tied.id],"TASK-011 stable nearest/ID target ordering")
	t.check(ally not in query,"TASK-011 friendly target excluded from queries")
	t.equal(ally.receive_damage(20.0,"fire",1,100.0),0.0,"TASK-011 no friendly damage")
	t.equal(ally.health.current,100.0,"TASK-011 friendly HP unchanged")
	enemy.health.damage(999,"fire",100)
	t.check(enemy not in r.targets.query(Vector2(350,340),100,1),"TASK-011 dead targets excluded")
	r.targets.remove(tied.id)
	t.check(tied not in r.targets.query(Vector2(350,360),100,1),"TASK-011 removed targets excluded")
	var target = Target.new(200,2,Vector2.ZERO,100,10,100.0,{"fire":0.5})
	t.equal(target.receive_damage(12.0,"fire",1,100.0),3.0,"TASK-012 damage armor + resistance math fixture")
	t.equal(target.receive_damage(12.0,"water",1,100.0),6.0,"TASK-012 water uses same damage receiver")
	t.equal(target.receive_damage(12.0,"lightning",1,100.0),6.0,"TASK-012 lightning uses same damage receiver")
	var manual = Status.new()
	var definition: Dictionary = r.settings["statuses"]["wet"]
	t.check(manual.apply("wet",0,definition)["ok"],"TASK-020 status applied")
	t.check(manual.has("wet",99),"TASK-020 Wet present before expiration")
	manual.apply("burning",0,r.settings["statuses"]["burning"])
	t.check(manual.has("wet") and manual.has("burning"),"TASK-020 Wet and Burning can coexist before resolver removal")
	t.check(manual.tick(241,r.settings["statuses"]).size() > 0,"TASK-020 status ticks and expires")
	t.check(not manual.has("wet"),"TASK-020 expired Wet removed")
	var created = r.loadout.equip(0,samples["sample.fire_shot"])
	t.check(created["ok"],"TASK-024 Fire Shot can equip")
	var second = r.loadout.equip(1,samples["sample.water_shot"])
	t.check(second["ok"],"TASK-024 Water Shot can equip independently")
	t.equal(r.loadout.preview(0)["formula_id"],"sample.fire_shot","TASK-024 slot 1 formula ID")
	t.equal(r.loadout.preview(1)["formula_id"],"sample.water_shot","TASK-024 slot 2 formula ID")
	t.equal(r.loadout.preview(0)["mana"],7,"TASK-023 rune-derived mana preview")
	var swap_target = r.add_target(Vector2(465,340),Vector2.ZERO,500.0)
	var mana_before: float = r.mana
	var fire = r.try_cast(0,r.actor.position,Vector2.RIGHT)
	t.check(fire["accepted"],"TASK-013 Fire Projectile accepted")
	t.equal(r.mana,mana_before-7.0,"TASK-023 mana charged once")
	var cooldown = r.try_cast(0,r.actor.position,Vector2.RIGHT)
	t.equal(cooldown["reason"],"COOLDOWN","TASK-023 cooldown prevents immediate recast")
	t.equal(r.mana,mana_before-7.0,"TASK-023 rejected cast does not change mana")
	t.check(r.loadout.equip(0,samples["sample.water_shot"])["ok"],"TASK-024 hot swap source slot")
	_run_ticks(r,70)
	t.check(r.trace.filter_records(fire["cast_id"],"","hit").size() > 0,"TASK-013 projectile resolves hit")
	var fire_hit = r.targets.get_target(ally.id)
	t.equal(fire_hit.health.current,100.0,"TASK-013 nearby ally never receives projectile damage")
	t.check(swap_target.status.has("burning",r.clock.tick),"TASK-024 hot-swapped slot leaves prior Fire projectile immutable")
	# Target-store test was deliberately isolated: use a fresh world for actual interactions.
	var spells = _init_runner()
	var d1 = spells.add_target(Vector2(295,340),Vector2.ZERO,500.0)
	spells.equip(0,samples["sample.fire_shot"])
	spells.equip(1,samples["sample.water_shot"])
	var shot = spells.try_cast(0,spells.actor.position,Vector2.RIGHT)
	t.check(shot["accepted"],"TASK-021 fire shot cast accepted")
	_run_ticks(spells,30)
	t.check(d1.status.has("burning",spells.clock.tick),"TASK-021 Fire applies Burning")
	var hp_at_30: float = d1.health.current
	_run_ticks(spells,32)
	t.check(d1.health.current < hp_at_30,"TASK-021 Burning causes fixed-tick DOT")
	var after_fire: float = d1.health.current
	var water_cast = spells.try_cast(1,spells.actor.position,Vector2.RIGHT)
	t.check(water_cast["accepted"],"TASK-021 Water cast accepted")
	_run_ticks(spells,30)
	t.check(d1.status.has("wet",spells.clock.tick),"TASK-021 Water applies Wet")
	t.check(not d1.status.has("burning",spells.clock.tick),"TASK-021 Water extinguishes Burning")
	t.check(d1.health.current < after_fire,"TASK-021 water hit produces direct damage")
	var hp_no_dot: float = d1.health.current
	_run_ticks(spells,35)
	t.equal(d1.health.current,hp_no_dot,"TASK-021 no Burning DOT after extinguish")
	var wet2 = spells.add_target(Vector2(395,340),Vector2.ZERO,500)
	spells.equip(0,samples["sample.water_burst"])
	spells.try_cast(0,wet2.position,Vector2.RIGHT)
	t.check(wet2.status.has("wet",spells.clock.tick) == false,"TASK-014 burst resolves via queue (not immediate reentry)")
	spells.advance_one_tick()
	t.check(wet2.status.has("wet",spells.clock.tick),"TASK-014 root Burst hits target in radius")
	var far = spells.add_target(Vector2(800,600))
	var hp_far: float = far.health.current
	t.check(far.health.current == hp_far,"TASK-014 outside radius unaffected")
	spells.equip(0,samples["sample.lightning_shot"])
	_run_ticks(spells,12)
	var lightning = spells.try_cast(0,spells.actor.position,Vector2.RIGHT)
	t.check(lightning["accepted"],"TASK-022 lightning cast")
	_run_ticks(spells,35)
	t.equal(spells.trace.filter_records(lightning["cast_id"],"","reaction").size(),1,"TASK-022 Wet lightning causes one arc")
	t.check(wet2.health.current < 500,"TASK-022 second Wet target receives derived arc")
	t.check(wet2.status.has("wet",spells.clock.tick),"TASK-022 arc does not consume Wet")
	var alone = _init_runner()
	var sole = alone.add_target(Vector2(295,340),Vector2.ZERO,500)
	alone.equip(0,samples["sample.lightning_shot"])
	var no_arc = alone.try_cast(0,alone.actor.position,Vector2.RIGHT)
	_run_ticks(alone,40)
	t.equal(alone.trace.filter_records(no_arc["cast_id"],"","reaction").size(),0,"TASK-022 lightning alone does not arc")
	var runner = _init_runner()
	var target_a = runner.add_target(Vector2(325,275),Vector2.ZERO,1000.0)
	var target_b = runner.add_target(Vector2(325,340),Vector2.ZERO,1000.0)
	var target_c = runner.add_target(Vector2(325,405),Vector2.ZERO,1000.0)
	runner.equip(0,samples["sample.split_fire_trigger"])
	var spawn_cast = runner.try_cast(0,runner.actor.position,Vector2.RIGHT)
	t.check(spawn_cast["accepted"],"TASK-017 Split+OnHit equipped and cast")
	t.equal(runner.active.size(),3,"TASK-017 split creates three instances")
	t.equal(runner.trace.filter_records(spawn_cast["cast_id"],"","cost_paid").size(),1,"TASK-017 once-per-cast mana charge")
	_run_ticks(runner,65)
	t.equal(runner.trace.filter_records(spawn_cast["cast_id"],"","trigger").size(),3,"TASK-019 each Split projectile triggers")
	t.check(runner.trace.filter_records(spawn_cast["cast_id"],"","spawn").size() >= 6,"TASK-019 independent On Hit Burst children")
	for entry in runner.trace.filter_records(spawn_cast["cast_id"],"","spawn"):
		if int(entry["depth"]) == 1:
			t.check(int(entry["parent_effect_id"]) > 0,"TASK-019 payload preserves parent ID")
	var piercing = _init_runner()
	for x in [280,365,450]:
		piercing.add_target(Vector2(x,340),Vector2.ZERO,1000.0)
	piercing.equip(0,samples["sample.pierce_water_trigger"])
	var piercing_cast = piercing.try_cast(0,piercing.actor.position,Vector2.RIGHT)
	_run_ticks(piercing,75)
	t.equal(piercing.trace.filter_records(piercing_cast["cast_id"],"","trigger").size(),3,"TASK-018/019 pierce triggers once per unique target")
	t.equal(piercing.trace.filter_records(piercing_cast["cast_id"],"","cost_paid").size(),1,"TASK-023 Pierce+trigger paid once")
	var orbs = _init_runner()
	orbs.add_target(Vector2(214,340),Vector2.ZERO,500)
	orbs.equip(0,samples["sample.orbit_fire"])
	var orb_cast = orbs.try_cast(0,orbs.actor.position,Vector2.RIGHT)
	t.check(orb_cast["accepted"],"TASK-015 orb casts")
	_run_ticks(orbs,20)
	var orb = orbs.active[0]["effect"]
	var position_before: Vector2 = orb.position
	orbs.actor.position += Vector2(100,0)
	orbs.step()
	t.check(orb.position.distance_to(position_before) > 70,"TASK-015 orb tracks moving caster")
	t.check(orbs.trace.filter_records(orb_cast["cast_id"],"","hit").size() < 15,"TASK-015 overlapping target has bounded re-hits")
	var highspeed = _init_runner()
	highspeed.actor.position = Vector2(50,50)
	var small = highspeed.add_target(Vector2(115,50))
	small.radius = 2.0
	var plan = highspeed.loadout.compiler.compile(samples["sample.fire_shot"],highspeed.registry.get_ids())["compiled_spell"].snapshot()["root"]
	plan["params"]["speed"] = 6000.0
	plan["params"]["radius"] = 2.0
	var raw = Projectile.new({"effect_id":999,"cast_id":1,"formula_id":"test.fast","caster_id":highspeed.actor.id,
		"team":1,"position":Vector2(50,50),"direction":Vector2.RIGHT,"root":plan,"max_targets":1})
	var sweep: Array = raw.advance(1.0/60.0,highspeed.targets,highspeed.bounds)
	t.equal(sweep.size(),1,"TASK-013 swept projectile catches target between endpoints")
	var narrow = _init_runner()
	narrow.limits.configure(narrow.limits.snapshot().merged({"max_effects_per_cast":1},true))
	narrow.add_target(Vector2(325,340),Vector2.ZERO,500)
	narrow.equip(0,samples["sample.split_fire_trigger"])
	var capped = narrow.try_cast(0,narrow.actor.position,Vector2.RIGHT)
	t.equal(narrow.active.size(),1,"TASK-017 split children obey spawn cap")
	t.equal(narrow.trace.filter_records(capped["cast_id"],"","budget_exceeded").size(),1,"TASK-017 child budget violation logged")
	var lock = _init_runner()
	lock.loadout.unlocked = ["essence.fire","form.projectile"]
	var locked = lock.equip(0,samples["sample.lightning_shot"])
	t.check(not locked["ok"],"TASK-024 locked rune cannot equip")
	lock.loadout.allow_edit = false
	t.equal(lock.equip(0,samples["sample.fire_shot"])["reason"],"EDIT_CONTEXT_BLOCKED","TASK-024 equip only in sandbox/workshop")
	var paused = _init_runner()
	paused.clock.set_paused(true)
	var tick_before: int = paused.clock.tick
	paused.step()
	t.equal(paused.clock.tick,tick_before,"TASK-020 paused simulation does not tick statuses")
	paused.advance_one_tick()
	t.equal(paused.clock.tick,tick_before+1,"TASK-025 manual single-step advances exactly one")
	var stress = _init_runner()
	var summary: Dictionary = stress.stress()
	t.equal(summary["accepted"],stress.limits.get_limit("max_effects_per_cast"),"TASK-025 stress exposes spawn cap")
	t.equal(stress.trace.filter_records(-1,"sandbox.stress","budget_exceeded").size(),1,"TASK-025 stress cap trace visible")
	var repeated = _init_runner()
	var summary_again: Dictionary = repeated.stress()
	t.equal(summary,summary_again,"TASK-025 fixed-seed stress reproducible")
	t.equal(stress.trace_json(),repeated.trace_json(),"TASK-025 reset/seed yields identical trace")
