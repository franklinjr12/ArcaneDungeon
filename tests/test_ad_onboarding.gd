extends RefCounted
## AD-042: data-driven onboarding tips, once per profile, one on screen.
const Prompts = preload("res://ui/onboarding_prompts.gd")

func run(t) -> void:
	var raw: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(Prompts.FLAVOUR_PATH))
	t.check(raw.has("onboarding"), "AD-042 onboarding block exists")
	var p = Prompts.new()
	for id in Prompts.TIP_IDS:
		var s := str(p.tips.get(id, ""))
		t.check(not s.is_empty() and s.length() <= Prompts.MAX_CHARS, "AD-042 tip loads and fits: " + id)
		t.check(not s.containsn("battlemage"), "AD-042 no Battlemage: " + id)
	t.check(str(p.tips["room1"]).contains("Space") and str(p.tips["room1"]).contains("i-frames"), "AD-042 room1 text")
	t.check(str(p.tips["first_reward"]).contains("3 cards"), "AD-042 first_reward text")
	t.check(str(p.tips["first_workshop"]).contains("slot 4"), "AD-042 first_workshop text")
	t.equal(p.trigger("room1"), p.tips["room1"], "AD-042 first trigger returns text")
	t.equal(p.trigger("room1"), "", "AD-042 second trigger empty")
	p.trigger("first_reward")
	t.equal(p.current, "first_reward", "AD-042 new tip replaces current")
	t.equal(p.text(), p.tips["first_reward"], "AD-042 only one tip visible")
	t.equal(p.trigger("nope"), "", "AD-042 unknown id")
	p.dismiss()
	t.equal(p.text(), "", "AD-042 dismiss clears text")
	p.reopen()
	t.equal(p.text(), "", "AD-042 reopen does not resurrect")
	t.equal(p.trigger("first_reward"), "", "AD-042 seen tip not re-shown")
	var q = Prompts.new()
	q.load_seen(["room1", "bogus"])
	t.equal(q.trigger("room1"), "", "AD-042 seen from profile suppressed")
	t.check(not q.seen.has("bogus"), "AD-042 unknown seen id dropped")
	_ad084(t)

func _ad084(t) -> void:
	var raw = JSON.parse_string(FileAccess.get_file_as_string(Prompts.STRINGS_PATH))
	t.check(raw is Dictionary, "AD-084 strings file parses")
	var p = Prompts.new()
	for id in Prompts.HINT_IDS:
		t.check(raw.has("onboarding." + id), "AD-084 strings key: " + id)
		var s := str(p.tips.get(id, ""))
		t.check(not s.is_empty() and s.length() <= Prompts.MAX_CHARS, "AD-084 hint loads and fits: " + id)
	p.note_workshop(2)
	t.equal(p.next_hint(), "workshop_empty_slot", "AD-084 empty slots queue hint")
	t.equal(p.trigger("workshop_empty_slot"), p.tips["workshop_empty_slot"], "AD-084 workshop hint shown once")
	t.equal(p.trigger("workshop_empty_slot"), "", "AD-084 workshop hint not repeated")
	p.note_workshop(0)
	p.note_valid_edit()
	t.equal(p.next_hint(), "test_on_dummy", "AD-084 valid edit queues test hint")
	t.equal(p.trigger("test_on_dummy"), p.tips["test_on_dummy"], "AD-084 test hint shown")
	p.note_test_cast()
	t.equal(p.text(), "", "AD-084 test cast clears hint")
	t.equal(p.trigger("test_on_dummy"), "", "AD-084 test hint once")
	p.note_wet_kill()
	t.equal(p.trigger("wet_try_lightning"), p.tips["wet_try_lightning"], "AD-084 wet hint shown")
	t.equal(p.trigger("wet_try_lightning"), "", "AD-084 wet hint once")
	t.equal(p.shown_count, 3, "AD-084 shown_count equals successful triggers")
	t.equal(p.shown_log.size(), 3, "AD-084 shown_log")
	var q = Prompts.new()
	t.check(q.note_arc(), "AD-084 note_arc true first time")
	t.check(not q.note_arc(), "AD-084 note_arc false after")
	q.note_wet_kill()
	t.equal(q.next_hint(), "", "AD-084 no wet hint after arc")
	t.equal(q.trigger("wet_try_lightning"), "", "AD-084 wet hint not triggerable after arc")
	var r = Prompts.new()
	r.note_wet_kill()
	r.trigger("wet_try_lightning")
	t.check(r.text() != "", "AD-084 wet hint visible")
	r.note_arc()
	t.equal(r.text(), "", "AD-084 arc clears current wet hint")
	r.dismiss()
	r.pending = ["test_on_dummy"]
	t.equal(r.next_hint(), "", "AD-084 dismissed gives no hint")
	# Persistence through SaveService.
	var dir := "user://ad084_test/"
	DirAccess.make_dir_recursive_absolute(dir)
	var svc = preload("res://game/core/save_service.gd").new()
	svc.set_base_dir(dir)
	var w = Prompts.new()
	for id in Prompts.HINT_IDS:
		w.trigger(id)
	svc.profile["stats"]["onboarding_seen"] = w.seen
	t.equal(svc.save_profile(), OK, "AD-084 profile saved")
	var svc2 = preload("res://game/core/save_service.gd").new()
	svc2.set_base_dir(dir)
	svc2.load_profile()
	var n = Prompts.new()
	n.load_seen(svc2.profile["stats"].get("onboarding_seen", []))
	for id in Prompts.HINT_IDS:
		t.equal(n.trigger(id), "", "AD-084 persisted hint suppressed: " + id)
	t.check(n.arc_seen, "AD-084 arc_seen restored")
	svc.free()
	svc2.free()
	for f in DirAccess.get_files_at(dir):
		DirAccess.remove_absolute(dir + f)
	DirAccess.remove_absolute(dir)
	# Telemetry.
	var Log = preload("res://debug/experiment_log.gd")
	var lg = Log.new()
	lg.configure(true)
	lg.record("prompt_shown", {"prompt_index": 0})
	lg.record("prompt_shown", {"prompt_index": 1})
	t.equal(lg.summary()["counts"]["prompt_shown"], 2, "AD-084 prompt_shown counted")
	var off = Log.new()
	off.configure(false)
	off.record("prompt_shown", {"prompt_index": 0})
	t.equal(off.records.size(), 0, "AD-084 disabled log records nothing")
